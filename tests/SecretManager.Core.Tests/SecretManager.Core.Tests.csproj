<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../../src/SecretManager.Core/SecretManager.Core.csproj" />
    <ProjectReference Include="../SecretManager.UpdateFixture/SecretManager.UpdateFixture.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/SecretManager.App/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/SecretManager.App/Services/ThemePalette.cs" Link="Appearance/ThemePalette.cs" />
    <Compile Include="../../src/SecretManager.App/Services/MotionGeometry.cs" Link="Appearance/MotionGeometry.cs" />
    <Compile Include="../../src/SecretManager.App/Services/AppPaths.cs" Link="Diagnostics/AppPaths.cs" />
    <Compile Include="../../src/SecretManager.App/Services/DiagnosticJournal.cs" Link="Diagnostics/DiagnosticJournal.cs" />
    <Compile Include="../../src/SecretManager.App/Services/UpdateService.cs" Link="Windows/UpdateService.cs" />
    <Compile Include="../../src/SecretManager.App/Services/DevicePreferences.cs" Link="Windows/DevicePreferences.cs" />
  </ItemGroup>
  <Target Name="CopyUpdateFixture" AfterTargets="Build">
    <MSBuild Projects="../SecretManager.UpdateFixture/SecretManager.UpdateFixture.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="UpdateFixtureTarget" />
    </MSBuild>
    <PropertyGroup><UpdateFixtureDirectory>@(UpdateFixtureTarget->'%(RootDir)%(Directory)')</UpdateFixtureDirectory></PropertyGroup>
    <ItemGroup><UpdateFixture Include="$(UpdateFixtureDirectory)SecretManager.UpdateFixture.*" /></ItemGroup>
    <Copy SourceFiles="@(UpdateFixture)" DestinationFolder="$(OutDir)update-fixture" />
  </Target>
</Project>
