<Window x:Class="SecretManager.ThemeChecks.ThemeCheckWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="using:SecretManager.App.Services" xmlns:controls="using:SecretManager.App.Controls"
 Title="SecretManager — theme checks (synthetic data)">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources><services:ThemeResources/></Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
  <Border x:Name="Sidebar" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="18">
   <StackPanel Spacing="24">
    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon x:Name="SemanticIcon" Glyph="&#xE72E;" FontSize="20"/><TextBlock Text="SecretManager" FontWeight="SemiBold"/></StackPanel>
    <TextBlock Text="ПРОСТРАНСТВО" FontSize="10" Foreground="{ThemeResource VaultSecondaryTextBrush}"/>
    <Button Content="Все ассоциации" HorizontalAlignment="Stretch"/>
    <TextBlock Text="БЫСТРЫЙ ПЕРЕХОД" FontSize="10" Foreground="{ThemeResource VaultSecondaryTextBrush}"/>
    <TextBlock Text="Пример ассоциации"/>
    <TextBlock Text="Импорт / Экспорт" Foreground="{ThemeResource VaultSecondaryTextBrush}"/>
   </StackPanel>
  </Border>
  <Grid Grid.Column="1" Padding="22" RowSpacing="18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <AutoSuggestBox PlaceholderText="Поиск по названию ассоциации"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find"/></AutoSuggestBox.QueryIcon></AutoSuggestBox>
   <Grid Grid.Row="1"><StackPanel Spacing="6"><TextBlock x:Name="ThemeName" Text="Ваши секреты" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Синтетические данные · проверка оформления" FontSize="12" Foreground="{ThemeResource VaultSecondaryTextBrush}"/></StackPanel></Grid>
   <Grid Grid.Row="2">
    <ListView x:Name="CardList" SelectionMode="None" Padding="12,10,12,12" HorizontalContentAlignment="Stretch" Background="Transparent">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/></Style></ListView.ItemContainerStyle>
     <Expander x:Name="Card" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True" Header="Пример ассоциации">
      <StackPanel Spacing="16">
       <TextBlock Text="Описание / Значение" Foreground="{ThemeResource VaultSecondaryTextBrush}"/>
       <TextBox Header="Логин" Text="demo@example.invalid"/>
       <PasswordBox Header="Секрет" Password="Synthetic sample"/>
       <Button Content="Добавить поле"/>
      </StackPanel>
     </Expander>
    </ListView>
    <controls:ToastNotification x:Name="Toast" Canvas.ZIndex="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,8,20,0" MaxWidth="440" Background="{ThemeResource VaultCardBrush}" BorderBrush="{ThemeResource VaultStrokeBrush}"/>
   </Grid>
  </Grid>
  <Border x:Name="SettingsPanel" Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="20">
   <StackPanel Spacing="18">
    <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Оформление" FontSize="17" FontWeight="SemiBold"/>
    <ComboBox x:Name="ThemeChoice" Header="Тема" HorizontalAlignment="Stretch" SelectedIndex="0"><x:String>Проверка палитры</x:String><x:String>Другой вариант</x:String></ComboBox>
    <Button x:Name="AccentButton" Content="Новая ассоциация" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
    <TextBlock Text="Цвета меню, панели, полей, кнопок и текста должны принадлежать одной теме." TextWrapping="Wrap" Foreground="{ThemeResource VaultSecondaryTextBrush}" FontSize="12"/>
    <NumberBox Header="Размер текста" Value="14" SpinButtonPlacementMode="Compact"/>
    <Slider Header="Скругление" Minimum="0" Maximum="28" Value="14"/>
    <ToggleSwitch x:Name="CompactToggle" Header="Компактный список" IsOn="True"/>
    <ToggleSwitch x:Name="AccordionToggle" Header="Только одна раскрытая ассоциация" IsOn="False"/>
    <Button Content="Сохранить настройки" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
    <InfoBar x:Name="SuccessInfo" IsOpen="True" IsClosable="False" Severity="Success" Message="Значки WinUI сохранены"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
