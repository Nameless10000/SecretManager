<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SecretManager.ThemeChecks</RootNamespace>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI><ImplicitUsings>disable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>true</SelfContained><PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>../../src/SecretManager.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <ProjectReference Include="../../src/SecretManager.Core/SecretManager.Core.csproj" />
    <Compile Include="../../src/SecretManager.App/Services/ThemePalette.cs" Link="Shared/ThemePalette.cs" />
    <Compile Include="../../src/SecretManager.App/Services/ThemeResources.cs" Link="Shared/ThemeResources.cs" />
    <Compile Include="../../src/SecretManager.App/Services/ThemeService.cs" Link="Shared/ThemeService.cs" />
    <Compile Include="../../src/SecretManager.App/Services/MotionGeometry.cs" Link="Shared/MotionGeometry.cs" />
    <Compile Include="../../src/SecretManager.App/Services/MotionService.cs" Link="Shared/MotionService.cs" />
    <Compile Include="../../src/SecretManager.App/Services/AttachmentImportService.cs" Link="Shared/AttachmentImportService.cs" />
    <Compile Include="../../src/SecretManager.App/Controls/AttachmentInput.cs" Link="Shared/AttachmentInput.cs" />
    <Compile Include="../../src/SecretManager.App/Controls/ToastNotification.cs" Link="Shared/ToastNotification.cs" />
    <Compile Include="../../src/SecretManager.App/GlobalUsings.cs" Link="Shared/GlobalUsings.cs" />
    <Compile Include="../../src/SecretManager.App/MainWindow.xaml.cs" Link="Production/MainWindow.xaml.cs" />
    <Compile Include="../../src/SecretManager.App/ViewModels/*.cs" Link="Production/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../src/SecretManager.App/Services/AppPaths.cs" Link="Production/AppPaths.cs" />
    <Compile Include="../../src/SecretManager.App/Services/DiagnosticJournal.cs" Link="Production/DiagnosticJournal.cs" />
    <Compile Include="../../src/SecretManager.App/Services/ClipboardService.cs" Link="Production/ClipboardService.cs" />
    <Compile Include="../../src/SecretManager.App/Services/TrayService.cs" Link="Production/TrayService.cs" />
    <Compile Include="../../src/SecretManager.App/Services/NativeMethods.cs" Link="Production/NativeMethods.cs" />
    <Page Include="../../src/SecretManager.App/MainWindow.xaml" Link="MainWindow.xaml" />
    <Content Include="../../src/SecretManager.App/Assets/*" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
